# Keep this file free of credentials. Copy it to .env and fill in locally.
GEMINI_API_KEY=
# Generate a random token (at least 32 characters). Enter the same token in app Settings.
COOKING_API_TOKEN=
HOST=127.0.0.1
PORT=8787
# A single-process MVP guard shared by all authenticated clients.
MAX_REQUESTS_PER_MINUTE=30
MAX_CONCURRENT_REQUESTS=2
GEMINI_TIMEOUT_MS=15000
